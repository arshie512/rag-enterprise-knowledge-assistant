# Local embedding model used both during indexing and querying.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu

# Local answer model. Install Ollama and run ollama pull llama3.2:3b.
OLLAMA_MODEL=llama3.2:3b
OLLAMA_REQUEST_TIMEOUT=180

# Chunking and retrieval defaults. Rebuild the index after changing chunk settings.
CHUNK_SIZE=350
CHUNK_OVERLAP=60
TOP_K=3
CHAT_MEMORY_TOKENS=2000

# Local paths are relative to the project folder.
SOURCE_DOCUMENTS_DIR=data/assignment_brief
CHROMA_DB_DIR=storage/chroma
CHROMA_COLLECTION=enterprise_knowledge

# Keep downloaded model and temporary files in this project.
MODEL_CACHE_DIR=storage/models
TEMP_DIR=storage/tmp
